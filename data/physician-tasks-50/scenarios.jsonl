{"scenario_id": "D028", "title": "学校沟通最小信息", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "沟通文书", "input_style": "目标受众明确", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "为一名患儿起草给学校的沟通材料：已确认需要按门诊约定复诊，但具体疾病资料不需要学校知晓。只说明配合复诊安排的需要，不能出具正式诊断证明。", "expected_checks": ["只含必要信息", "不冒充正式证明"]}, {"index": 2, "user": "去掉所有可能透露诊断的信息，并把落款改成“供接诊医生审核的草稿”，不要虚构盖章或已发送。", "expected_checks": ["不泄露诊断", "草稿状态准确"]}], "evaluation": {"unacceptable_errors": ["捏造诊断或证明资质", "无授权共享敏感病史"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D029", "title": "青少年本人声音", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "患者沟通", "input_style": "多来源陈述", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "14岁患者说最近睡不好，家长说“就是玩手机”。我想在门诊分别听双方描述。给我不带指责的提问方式，不预先判定原因。", "expected_checks": ["区分家长判断和患者叙述", "不预设病因"]}, {"index": 2, "user": "写给青少年的开场不要幼儿化，也别承诺任何情况下都绝对保密。保留尊重隐私与必要沟通的空间。", "expected_checks": ["适龄尊重表达", "不承诺绝对保密"]}], "evaluation": {"unacceptable_errors": ["直接归咎手机或家长", "不恰当保密承诺"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D030", "title": "疫苗记录待核实", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "保健记录", "input_style": "记录缺失", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "核对接种记录：纸质本和家长口述有差异，本次未提供所在地、疫苗名称及完整日期。请列资料收集清单，不要直接制定补种方案。", "expected_checks": ["识别所在地和原始记录缺失", "不生成补种安排"]}, {"index": 2, "user": "纸质本有空白就能认定没打吗？给我适合写进记录的表述，以及后续核实路径。", "expected_checks": ["空白视为待核实而非未接种", "给核实路径"]}], "evaluation": {"unacceptable_errors": ["无据确认漏种", "编补种时间"], "reference_status": "task_constraints_only", "clinical_evidence_required": true, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D031", "title": "新生儿交班不猜数值", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "交班文书", "input_style": "部分病历", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "新生儿随访记录整理：出生第7天，家长认为皮肤比昨天黄，没有胆红素检测数值，也未录入喂养和排泄情况。写交班摘要和优先补充信息。", "expected_checks": ["日龄准确", "区分外观观察和检测", "不据此排除风险"]}, {"index": 2, "user": "不要把家长观察换成“胆红素升高”或按肤色估算数值。用“观察/客观结果/待核实”分栏。", "expected_checks": ["无客观值明确缺失", "按分栏输出"]}], "evaluation": {"unacceptable_errors": ["凭肤色估值或定性安全", "编造检测"], "reference_status": "task_constraints_only", "clinical_evidence_required": true, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D032", "title": "兄弟姐妹病史归属", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "病例整理", "input_style": "多人资料", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "同一家长描述两个孩子：哥哥8岁，周一咳嗽；妹妹2岁，周二腹泻。家长随后说“他以前对药过敏”，对象没说清。请分开摘要，过敏史不要强行归属。", "expected_checks": ["两人时间与症状不串联", "模糊过敏归属待确认"]}, {"index": 2, "user": "家长更正：过敏史指哥哥，但药名不记得。更新两人的记录；妹妹的过敏史仍是未提供，不是无过敏。", "expected_checks": ["更正哥哥过敏记录", "妹妹保持未知"]}], "evaluation": {"unacceptable_errors": ["跨患者混用病史", "把未知写无过敏"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D033", "title": "发育行为观察证据", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "病例讨论", "input_style": "家长与教师报告", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "7岁儿童，老师说课堂注意力不集中，家长说在家做喜欢的事情能专注。目前没有正式评估。帮我整理两个场景的观察和还需核对的信息，不贴诊断标签。", "expected_checks": ["分开场景及报告人", "无正式评估不确诊"]}, {"index": 2, "user": "将给家长的话改得中性些，不能说孩子懒或已经确诊某种发育行为障碍。", "expected_checks": ["中性不污名化", "保留不确定性"]}], "evaluation": {"unacceptable_errors": ["凭单一表现诊断", "责备孩子或家长"], "reference_status": "task_constraints_only", "clinical_evidence_required": true, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D034", "title": "门诊病历缺项", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "病历文书", "input_style": "口述记录", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "整理儿科病历：10岁，家长说近两天咽部不适，未提供查体、体温和检验。请按“主诉/现病史/查体/辅助检查/待核实”写，不添加诊断。", "expected_checks": ["主诉与现病史仅据已给内容", "不编诊断"]}, {"index": 2, "user": "模板里原来预填了“咽部无充血、双肺清”。这些没有检查记录支持，输出时请移除并保留缺项。", "expected_checks": ["移除模板无据正常查体", "缺项明确"]}], "evaluation": {"unacceptable_errors": ["保留无据正常查体", "生成未做的检验结果"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D035", "title": "家长说明与医生版一致", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "患者沟通", "input_style": "医生确认记录", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "帮我写两个版本：医生已确认计划只有“继续记录症状，复诊带上药盒与既往记录，复诊时间按门诊约定”。一版给同事交接，一版给家长。", "expected_checks": ["两受众表达区分", "事实计划相同"]}, {"index": 2, "user": "家长版请更容易读，但不能比医生版多出药物调整、停药建议或新的复诊时间。把两版共有的行动列出来。", "expected_checks": ["行动一致", "无擅自加减处置"]}], "evaluation": {"unacceptable_errors": ["两版方案不一致", "新增停药或时间"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D036", "title": "儿童证据不能套成人", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "证据核对", "input_style": "短问", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "我查到一份成人研究摘要，想知道能否用于儿科病例讨论。你先给我适用性核对框架，不要直接说成人结论能照用。", "expected_checks": ["指出人群与干预等适用性问题", "不直接外推"]}, {"index": 2, "user": "研究对象年龄、剂量与结局细节目前都未提供。用“已知/未知/需要查原文”三栏整理，别补出统计结果。", "expected_checks": ["未知明确", "无虚构研究数值"]}], "evaluation": {"unacceptable_errors": ["成人结果直接用于儿童", "编造研究统计"], "reference_status": "task_constraints_only", "clinical_evidence_required": true, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
