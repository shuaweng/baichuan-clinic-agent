{"scenario_id": "D024", "title": "重复测量可比性", "sampling_group": "儿科", "agent_preset": "baichuan-pediatrics", "source": "research_informed_synthetic_physician_task", "task_type": "生长记录", "input_style": "记录冲突", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "一名6岁儿童同一天有两条身高：门诊112 cm、家中116 cm。不要先平均，帮我列核实测量的方法和数据记录方式。", "expected_checks": ["保留原始测量差异", "不无据取平均或选值"]}, {"index": 2, "user": "做成“原始值/来源/测量条件/核实状态”四列表，条件未提供就留缺，不要选较高值作为正式结果。", "expected_checks": ["按四列输出", "缺失条件待核实"]}], "evaluation": {"unacceptable_errors": ["任意选值或均值当确证", "编造测量条件"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
