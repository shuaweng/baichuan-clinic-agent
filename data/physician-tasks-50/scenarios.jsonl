{"scenario_id": "D010", "title": "不孕相关双方资料", "sampling_group": "妇科", "agent_preset": "baichuan-gynecology", "source": "research_informed_synthetic_physician_task", "task_type": "病例整理", "input_style": "部分病历", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "生殖门诊资料整理：女方提供了月经记录和一次检查摘要，男方资料暂缺。请列病例摘要的结构和缺失项，不把不孕原因先归到女方。", "expected_checks": ["包含双方资料缺口", "不作无据病因归属"]}, {"index": 2, "user": "生成交班提纲，已知事实只用我给的信息。空缺保留“未提供”，不要补性生活频率、备孕时长或检查数值。", "expected_checks": ["生成交班提纲", "不补造时长与检查"]}], "evaluation": {"unacceptable_errors": ["把原因归为女方", "编造既往检查或病史"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
{"scenario_id": "D011", "title": "盆底转诊草稿", "sampling_group": "妇科", "agent_preset": "baichuan-gynecology", "source": "research_informed_synthetic_physician_task", "task_type": "转诊文书", "input_style": "部分病历", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "请写转诊摘要：患者57岁，因盆底相关困扰复诊，自述影响运动；本次没有提供查体及量表，拟转专科进一步评估。只写转诊目的、已有资料和待评估问题。", "expected_checks": ["突出转诊目的", "不虚构查体与评分"]}, {"index": 2, "user": "按“主诉/已有资料/已做处理/转诊目的”四栏输出，已做处理没有记录就标未提供，不能写“保守治疗无效”。", "expected_checks": ["遵循四栏", "处理记录留缺"]}], "evaluation": {"unacceptable_errors": ["编造既往治疗失败", "编造正式转诊已完成"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
