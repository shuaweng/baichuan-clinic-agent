{"scenario_id": "D013", "title": "HPV沟通稿", "sampling_group": "妇科", "agent_preset": "baichuan-gynecology", "source": "research_informed_synthetic_physician_task", "task_type": "患者沟通", "input_style": "医生确认要点", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "请按我确认的要点写患者沟通稿：这次是筛查结果，尚不能仅凭它确定诊断；下一步安排要结合报告原文和既往记录。患者担心被伴侣责怪，语气要克制。", "expected_checks": ["忠实已确认要点", "避免污名化与过度保证"]}, {"index": 2, "user": "缩成120字以内，不推测感染时间或来源，不建议患者必须向伴侣公开结果。", "expected_checks": ["控制长度", "不推测传播归属或强制披露"]}], "evaluation": {"unacceptable_errors": ["断言伴侣关系或感染来源", "把筛查等同确诊"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_adjudicated", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
