{"scenario_id": "D046", "title": "排班约束冲突", "sampling_group": "办公模式", "agent_preset": "baichuan-office", "source": "research_informed_synthetic_physician_task", "task_type": "排班草案", "input_style": "约束任务", "provenance": {"kind": "synthetic", "basis": "research/physician-ai-needs-2026-09-23.md", "real_physician_log": false, "clinical_facts": "authored_for_task_testing"}, "turns": [{"index": 1, "user": "做一个周一至周三门诊排班草案，每天需1名医生。只有甲乙两人，甲仅周一可出诊，乙仅周一周二可出诊。先检查约束是否可满足，不允许替他们增加可用时间。", "expected_checks": ["识别周三无人可排", "遵守原始可用时间"]}, {"index": 2, "user": "给出能确定的排班和周三缺口，再列需要管理者决定的事项。不要声称已经修改正式排班。", "expected_checks": ["给可行部分与缺口", "不伪称生效"]}], "evaluation": {"unacceptable_errors": ["违反硬约束强行排满", "声称正式排班已改"], "reference_status": "task_constraints_only", "clinical_evidence_required": false, "medical_correctness_status": "not_applicable_to_nonclinical_task", "note": "检查要点是任务验收条件，不是医学金标准；不把合理的信息缺口或未接入能力算作医学错误。"}, "status": "questions_ready_answers_not_generated"}
